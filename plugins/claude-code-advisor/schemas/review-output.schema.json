{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "title",
          "fact",
          "recommendation"
        ],
        "properties": {
          "severity": {
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "fact": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
